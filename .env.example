# Postgres (see docker-compose.yml). Run `docker compose up -d` first.
# Connect as the non-superuser `app` role, never `postgres` — row-level security depends on it.
DATABASE_URL="postgresql://app:app@localhost:5432/order_monitor?schema=public"
# Direct (non-pooled) connection, used by `prisma migrate`. Same as DATABASE_URL unless you use a
# connection pooler. For Neon: DATABASE_URL = pooled host (-pooler) + `&pgbouncer=true`,
# DIRECT_URL = direct host, both with `sslmode=require`, both as the `app` role (see README).
DIRECT_URL="postgresql://app:app@localhost:5432/order_monitor?schema=public"

# Shopify app config — filled in by `shopify app config link` / the CLI, or by hand for local dev.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_orders
SHOPIFY_APP_URL=

# Queue provider (worker/index.ts). Only "aws" is implemented.
QUEUE_PROVIDER=aws
AWS_REGION=us-east-1
SQS_QUEUE_URL=
# Optional — omit to use the default AWS SDK credential chain (profile, instance role, etc.)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Feature flags
# Comment editing/deleting is implemented in the service layer but intentionally not exposed in
# the UI yet. Flip this on once that UI ships.
COMMENT_EDITING_ENABLED=false
