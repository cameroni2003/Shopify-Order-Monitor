# Env for the standalone worker container (worker/docker-compose.yml). Copy to .env next to the
# compose file and fill in.
# DATABASE_URL: connect as the non-superuser `app` role, never a superuser — row-level security
# depends on it. Neon: pooled (-pooler) host with &pgbouncer=true&sslmode=require.
DATABASE_URL=postgresql://app:<password>@<host>/<db>?sslmode=require&pgbouncer=true
AWS_REGION=us-east-1
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/<account-id>/<queue-name>
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
